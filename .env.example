# =============================================================================
# Xray Sub - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env
#
# Then start the service:
#   docker compose up -d
# =============================================================================

# ---------------------------------------------------------------------------
# Authentication (REQUIRED)
# ---------------------------------------------------------------------------

# Admin panel username.
ADMIN_USER=admin

# Admin panel password. CHANGE THIS before deploying.
# The application will refuse to start if this variable is not set.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------

# Base URL used when generating subscription links (e.g., https://vpn.example.com).
# Omit the trailing slash. Required for correct link generation.
# Example: https://vpn.example.com
BASE_URL=

# Comma-separated list of allowed CORS origins.
# Leave empty to disable CORS headers entirely.
# Example: https://vpn.example.com,https://admin.example.com
CORS_ORIGINS=

# Custom message shown to users when their device (HWID) limit is exceeded.
# If not set, a default Russian-language message is used.
DEVICE_LIMIT_MESSAGE=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Path to the SQLite database file inside the container.
# The default works with the named volume mounted at /app/data.
# You should not need to change this unless you remap the volume.
DB_PATH=data/app.db

# ---------------------------------------------------------------------------
# Backup (optional)
# ---------------------------------------------------------------------------

# Absolute path inside the container where periodic VACUUM INTO backups are
# written. Leave empty to disable automatic backups.
# Example: /app/data/backup.db
BACKUP_PATH=

# How often to run the backup. Go duration format (e.g., 1h, 30m, 6h).
# Only used when BACKUP_PATH is set. Default: 1h.
BACKUP_INTERVAL=1h

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Host port for the frontend (nginx) container. This is the main entry point.
# nginx serves the static frontend and reverse-proxies /api/* and /sub/*
# requests to the backend container.
HOST_PORT=8080

# Direct backend access is not exposed by default -- all traffic goes
# through the frontend nginx reverse proxy. To enable it, uncomment the
# ports section in docker-compose.yml (maps 127.0.0.1:8081 -> 8080).

# ---------------------------------------------------------------------------
# Build metadata (optional, used by docker-compose build args)
# ---------------------------------------------------------------------------

# These are injected into the Go binary at build time via -ldflags.
# Typically set by CI/CD pipelines, not manually.
# BUILD_VERSION=1.0.0
# BUILD_COMMIT=abc1234
# BUILD_TIME=2026-02-14T00:00:00Z
