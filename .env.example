# =============================================================================
# SubShare - Environment Configuration
# =============================================================================
# Recommended first start (creates .env automatically):
#   Ubuntu: bash scripts/start.sh
#   Windows: powershell -ExecutionPolicy Bypass -File .\scripts\start.ps1
# =============================================================================

# ---------------------------------------------------------------------------
# Authentication (required only for initial owner creation)
# ---------------------------------------------------------------------------

# Admin panel username.
ADMIN_USER=admin

# Initial owner password. Required only while the administrators table is empty.
# New passwords must contain 15-256 Unicode code points and at most 1024 UTF-8
# bytes. Spaces are allowed and the value is never trimmed or normalized.
# Quote the value according to your environment/tooling when it contains spaces.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------

# Runtime environment. Allowed values: development, production.
# Production requires a valid BASE_URL.
APP_ENV=development

# HTTP listen port or host:port. Valid port range: 1-65535.
# Examples: 8080, :8080, 127.0.0.1:8080
PORT=8080

# Public HTTP(S) origin used by both Caddy and the backend. It must contain no
# path, query, fragment, or credentials; omit the trailing slash.
# - Local/IP access: http://localhost or http://203.0.113.10
# - Public domain:  https://vpn.example.com (automatic HTTPS)
BASE_URL=http://localhost

# Comma-separated list of allowed HTTP(S) CORS origins, each without a path.
# Leave empty to disable CORS headers entirely.
# Example: https://vpn.example.com,https://admin.example.com
CORS_ORIGINS=

# Reverse proxy IPs/CIDRs allowed to supply X-Forwarded-For/X-Real-IP. Every
# non-empty item must be a valid IP address or CIDR.
# Docker's default private bridge commonly falls inside this range.
# Add 127.0.0.1/32 explicitly only when a local trusted proxy needs it.
TRUSTED_PROXIES=172.16.0.0/12

# Custom message shown to users when their device (HWID) limit is exceeded.
# If not set, a default Russian-language message is used.
DEVICE_LIMIT_MESSAGE=

# Optional external Happ URL encryption service. Disabled by default because
# enabling it sends the generated subscription URL (a bearer secret) to that
# service. Configure only a trusted absolute HTTP(S) URL without credentials.
# HAPP_CRYPTO_API_URL=https://trusted.example/api-v2.php

# Legacy subscription response encoding when response rules do not select a
# format. Allowed values: base64, plain. Default: base64.
SUBSCRIPTION_BODY_ENCODING=base64

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# These container paths are set by docker-compose.yml and normally do not need
# to be overridden.
DB_PATH=/app/data/app.db

# SQLite journal mode. Default WAL gives best performance on native Linux
# filesystems. For some bind mounts (e.g. non-native/virtualized FS) DELETE can
# be more stable.
# Allowed: WAL, DELETE, TRUNCATE, PERSIST, MEMORY, OFF
DB_JOURNAL_MODE=WAL

# ---------------------------------------------------------------------------
# Backup (optional)
# ---------------------------------------------------------------------------

# Automatic, integrity-checked backup retained in the persistent data volume.
# Use scripts/backup.sh or scripts/backup.ps1 to export it to the host.
# Leave empty to disable automatic backups.
BACKUP_PATH=/app/data/backups/app.db

# How often to run the backup. Go duration format (e.g., 1h, 30m, 6h).
# Only used when BACKUP_PATH is set. Default: 1h.
BACKUP_INTERVAL=1h

# Caddy listens on host ports 80 and 443. A BASE_URL beginning with https://
# enables automatic certificate issuance and renewal. DNS must point to this
# host and both ports must be reachable from the Internet.

# ---------------------------------------------------------------------------
# Build metadata (optional, used by docker-compose build args)
# ---------------------------------------------------------------------------

# These are injected into the Go binary at build time via -ldflags.
# Typically set by CI/CD pipelines, not manually.
# BUILD_VERSION=1.0.0
# BUILD_COMMIT=abc1234
# BUILD_TIME=2026-02-14T00:00:00Z
